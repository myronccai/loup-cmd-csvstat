@mode(host.scripted)

# Unit tests for csvstat's column selection (lib/columns.lpscr): names,
# indexes, ranges, exclusions and csvkit's error messages.
#
# Runtime: host.scripted, run by the test runner: `make test` interprets
# this file with Stage0 (`loup-bootstrap test --no-parallel --file`), one
# test per `func test_*()`. It imports lib/ with relative imports. It is not
# part of the program.

from debug.assert import (expect, expectEq);
from ..lib.columns import (match_column, parse_identifiers, select_columns);

let NAMES: list[string] = ["id", "first-name", "2020", "city", "zip"];

func picked(include: string, exclude: string): string {
    return match select_columns(NAMES, include, exclude) {
        Ok(indexes) => {
            let shown: list[string] = [str(k) for k in indexes];
            shown.join(",")
        },
        Err(message) => message,
    };
}

func test_all_columns_by_default(): void {
    expectEq(picked("", ""), "0,1,2,3,4", "everything");
    expectEq(select_columns([], "", "").unwrap().len(), 0, "no header, no columns");
}

func test_names_and_indexes(): void {
    expectEq(picked("city,1", ""), "3,0", "order as given");
    expectEq(picked("first-name", ""), "1", "a name with a dash is a name");
    expectEq(picked(" zip , id ", ""), "4,0", "spaces around items");
    expectEq(picked("2020", ""), "Column 2020 is invalid. The last column is 'zip' at index 5.", "digits are an index, as in csvkit");
}

func test_ranges(): void {
    expectEq(picked("2-4", ""), "1,2,3", "closed");
    expectEq(picked("4-", ""), "3,4", "open end");
    expectEq(picked("-2", ""), "0,1", "open start");
    expectEq(picked("1:2,5", ""), "0,1,4", "colon");
}

func test_exclusions(): void {
    expectEq(picked("", "city,1"), "1,2,4", "all but two");
    expectEq(picked("1-4", "2-3"), "0,3", "a range less a range");
}

func test_errors(): void {
    expectEq(picked("nope", ""), "Column 'nope' is invalid. It is neither an integer nor a column name. Column names are: 'id', 'first-name', '2020', 'city', 'zip'", "unknown name");
    expectEq(picked("0", ""), "Column 0 is invalid. Columns are 1-based.", "zero");
    expectEq(picked("3-9", ""), "Column 6 is invalid. The last column is 'zip' at index 5.", "range past the end");
    expectEq(picked("a-b", ""), "Invalid range 'a-b'. Ranges must be two integers separated by a - or : character.", "bad range");
    expectEq(picked("", "nope"), "Column 'nope' is invalid. It is neither an integer nor a column name. Column names are: 'id', 'first-name', '2020', 'city', 'zip'", "bad exclusion");
}

func test_match_column(): void {
    expectEq(match_column(NAMES, "zip").unwrap(), 4, "name");
    expectEq(match_column(NAMES, "5").unwrap(), 4, "index");
    expect(match_column(NAMES, "6").is_err(), "past the end");
    expectEq(parse_identifiers(NAMES, ",,1,").unwrap().len(), 1, "empty items are skipped");
}
