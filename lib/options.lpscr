@mode(host.scripted)

# csvstat's command line: the option table, the Options value and
# parse_args (Loup 1.26 has no CLI library).
#
# Grammar: csvstat [OPTION]... [FILE]
#   Short options may be combined (`-tH`) and take their value attached or
#   as the next word (`-d;`, `-d ';'`); long options take `--name VALUE` or
#   `--name=VALUE` and may be shortened to any unambiguous prefix
#   (`--no-header`), as csvkit's argparse allows. Options may follow the
#   file; `--` ends the options.
#
# Runtime: host.scripted. A module of the script bin/csvstat.lpscr,
# interpreted with it by `loup run`; tests/options_test.lpscr imports it
# under Stage0's test runner.
#
# Structure: OPTION_SPECS describes every option once. parse_args works in
# two passes: the first only reads the syntax, turning every word into the
# FILE or a (spec, value) step; the second applies the steps in order to an
# Options value with `with` copies, validating each value. Usage errors come
# back as Err(message) for the script to print.

from system.collections import (filter, find, all);
from system.text import (parseInt);

# One option: its long name, its short letter ("" for long-only options),
# whether it takes a value, and for the single-statistic options the
# statistic it selects.
pub struct OptionSpec {
    pub long: string;
    pub short: string;
    pub value: bool;
    pub stat: string;
}

func opt(long: string, short: string = "", value: bool = false, stat: string = ""): OptionSpec {
    return OptionSpec(long = long, short = short, value = value, stat = stat);
}

pub let OPTION_SPECS: list[OptionSpec] = [
    opt(long = "--delimiter", short = "d", value = true),
    opt(long = "--tabs", short = "t"),
    opt(long = "--no-header-row", short = "H"),
    opt(long = "--skip-lines", short = "K", value = true),
    opt(long = "--null-value", value = true),
    opt(long = "--blanks"),
    opt(long = "--no-inference", short = "I"),
    opt(long = "--columns", short = "c", value = true),
    opt(long = "--not-columns", short = "C", value = true),
    opt(long = "--names", short = "n"),
    opt(long = "--look"),
    opt(long = "--csv"),
    opt(long = "--json"),
    opt(long = "--indent", value = true),
    opt(long = "--type", stat = "type"),
    opt(long = "--nulls", stat = "nulls"),
    opt(long = "--non-nulls", stat = "nonnulls"),
    opt(long = "--unique", stat = "unique"),
    opt(long = "--min", stat = "min"),
    opt(long = "--max", stat = "max"),
    opt(long = "--sum", stat = "sum"),
    opt(long = "--mean", stat = "mean"),
    opt(long = "--median", stat = "median"),
    opt(long = "--stdev", stat = "stdev"),
    opt(long = "--len", stat = "len"),
    opt(long = "--max-precision", stat = "maxprecision"),
    opt(long = "--freq", stat = "freq"),
    opt(long = "--count", stat = "count"),
    opt(long = "--freq-count", value = true),
    opt(long = "--no-grouping-separator", short = "G"),
    opt(long = "--verbose", short = "v"),
    opt(long = "--help", short = "h"),
    opt(long = "--version", short = "V"),
];

pub const DEFAULT_FREQ_COUNT: int = 5;
pub const DEFAULT_INDENT: int = 2;

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub delimiter: string;
    pub no_header: bool;
    pub skip_lines: int;
    pub null_values: list[string];
    pub blanks: bool;
    pub no_inference: bool;
    pub columns: string;
    pub not_columns: string;
    pub names_only: bool;
    # "text" (the default report), "look", "csv" or "json".
    pub output: string;
    pub indent: int;
    # The one statistic to print ("mean", "count", ...), or "".
    pub only: string;
    pub freq_count: int;
    pub grouping: bool;
    pub verbosity: int;
    # The input file; "-" is standard input.
    pub file: string;
}

pub func default_options(): Options {
    return Options(
        help = false,
        version = false,
        delimiter = ",",
        no_header = false,
        skip_lines = 0,
        null_values = [],
        blanks = false,
        no_inference = false,
        columns = "",
        not_columns = "",
        names_only = false,
        output = "text",
        indent = DEFAULT_INDENT,
        only = "",
        freq_count = DEFAULT_FREQ_COUNT,
        grouping = true,
        verbosity = 0,
        file = "-",
    );
}

# A whole number of at least `least`, written with digits only.
pub func parse_count(text: string, least: int): Option[int] {
    let digits = text.chars();
    if (digits.len() == 0 or digits.len() > 9) {
        return None;
    }
    if (!all(digits, func(c: string): bool { return c >= "0" and c <= "9"; })) {
        return None;
    }
    let n = parseInt(text).unwrap_or(-1);
    return if (n >= least) { Some(n) } else { None };
}

# The spec for a long option, exactly or by an unambiguous prefix.
pub func find_long(name: string): Result[OptionSpec, string] {
    match find(OPTION_SPECS, func(s: OptionSpec): bool { return s.long == name; }) {
        Some(spec) => { return Ok(spec); },
        None => {},
    }
    let candidates = filter(OPTION_SPECS, func(s: OptionSpec): bool { return name.len() > 2 and s.long.startsWith(name); });
    if (candidates.len() == 1) {
        return Ok(candidates[0]);
    }
    if (candidates.len() == 0) {
        return Err(i"unrecognized option '{$ name $}'");
    }
    let names: list[string] = ["'" + c.long + "'" for c in candidates];
    return Err(i"option '{$ name $}' is ambiguous; possibilities: {$ names.join(" ") $}");
}

func find_short(letter: string): Option[OptionSpec] {
    return find(OPTION_SPECS, func(s: OptionSpec): bool { return s.short == letter; });
}

# Applies one option to the options so far.
func apply_step(o: Options, spec: OptionSpec, value: string): Result[Options, string] {
    match spec.long {
        "--delimiter" => {
            if (value.len() != 1) {
                return Err(i"the delimiter must be a single character, not '{$ value $}'");
            }
            if (value == "\"" or value == "\n" or value == "\r") {
                return Err("the delimiter cannot be a quote or a line break");
            }
            return Ok(o with (delimiter = value));
        },
        "--tabs" => { return Ok(o with (delimiter = "\t")); },
        "--no-header-row" => { return Ok(o with (no_header = true)); },
        "--skip-lines" => {
            match parse_count(value, 0) {
                Some(n) => { return Ok(o with (skip_lines = n)); },
                None => { return Err(i"invalid --skip-lines value '{$ value $}'"); },
            }
        },
        "--null-value" => { return Ok(o with (null_values = o.null_values + [value])); },
        "--blanks" => { return Ok(o with (blanks = true)); },
        "--no-inference" => { return Ok(o with (no_inference = true)); },
        "--columns" => {
            if (value.trim() == "") {
                return Err("the --columns list is empty");
            }
            return Ok(o with (columns = value));
        },
        "--not-columns" => {
            if (value.trim() == "") {
                return Err("the --not-columns list is empty");
            }
            return Ok(o with (not_columns = value));
        },
        "--names" => { return Ok(o with (names_only = true)); },
        "--indent" => {
            match parse_count(value, 0) {
                Some(n) => { return Ok(o with (indent = n)); },
                None => { return Err(i"invalid --indent value '{$ value $}'"); },
            }
        },
        "--freq-count" => {
            match parse_count(value, 1) {
                Some(n) => { return Ok(o with (freq_count = n)); },
                None => { return Err(i"invalid --freq-count value '{$ value $}'"); },
            }
        },
        "--no-grouping-separator" => { return Ok(o with (grouping = false)); },
        "--verbose" => { return Ok(o with (verbosity = o.verbosity + 1)); },
        "--help" => { return Ok(o with (help = true)); },
        "--version" => { return Ok(o with (version = true)); },
        _ => { return Ok(o); },
    }
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    # Pass 1: syntax. `-tHd;` becomes --tabs, --no-header-row,
    # --delimiter=";".
    var steps: list[(OptionSpec, string)] = [];
    var files: list[string] = [];
    var only_files = false;
    var i = 0;
    while (i < argv.len()) {
        let arg = argv[i];
        i += 1;
        if (only_files or arg == "-" or !arg.startsWith("-")) {
            files.push(arg);
            continue;
        }
        if (arg == "--") {
            only_files = true;
            continue;
        }
        if (arg.startsWith("--")) {
            let eq = arg.index_of("=");
            let name = if (eq >= 0) { arg.slice(0, eq) } else { arg };
            let spec = find_long(name)?;
            var value = "";
            if (spec.value and eq >= 0) {
                value = arg.slice(eq + 1);
            } else if (spec.value) {
                if (i >= argv.len()) {
                    return Err(i"option '{$ spec.long $}' requires an argument");
                }
                value = argv[i];
                i += 1;
            } else if (eq >= 0) {
                return Err(i"option '{$ spec.long $}' doesn't allow an argument");
            }
            steps.push((spec, value));
            continue;
        }
        var j = 1;
        while (j < arg.len()) {
            let letter = arg.slice(j, j + 1);
            j += 1;
            let spec = match find_short(letter) {
                Some(s) => s,
                None => { return Err(i"invalid option -- '{$ letter $}'"); },
            };
            var value = "";
            if (spec.value) {
                if (j < arg.len()) {
                    value = arg.slice(j);
                    j = arg.len();
                } else if (i < argv.len()) {
                    value = argv[i];
                    i += 1;
                } else {
                    return Err(i"option requires an argument -- '{$ letter $}'");
                }
            }
            steps.push((spec, value));
        }
    }

    # Pass 2: apply the steps in order; a repeated option overrides the
    # earlier one (`-d ';' -d '|'` gives '|'). The output mode and the
    # single statistic may each be chosen once.
    var o = default_options();
    var output_flag = "";
    var only_flag = "";
    for (step in steps) {
        let (spec, value) = step;
        if (spec.stat != "") {
            if (only_flag != "" and only_flag != spec.long) {
                return Err(i"only one statistic may be given ({$ only_flag $}, {$ spec.long $})");
            }
            only_flag = spec.long;
            o = o with (only = spec.stat);
        } else if (spec.long == "--look" or spec.long == "--csv" or spec.long == "--json") {
            if (output_flag != "" and output_flag != spec.long) {
                return Err(i"{$ output_flag $} and {$ spec.long $} cannot be combined");
            }
            output_flag = spec.long;
            o = o with (output = spec.long.slice(2));
        } else {
            o = apply_step(o, spec, value)?;
        }
    }
    if (only_flag != "" and output_flag != "") {
        return Err(i"{$ only_flag $} cannot be combined with {$ output_flag $}");
    }
    if (files.len() > 1) {
        return Err(i"extra operand '{$ files[1] $}'");
    }
    if (files.len() == 1) {
        o = o with (file = files[0]);
    }
    return Ok(o);
}
